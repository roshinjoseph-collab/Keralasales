function parseCSV(text){const lines=text.replace(/\r/g,'').split('\n').filter(x=>x.trim());const parseLine=l=>{let out=[],cur='',q=false;for(let i=0;i<l.length;i++){let c=l[i];if(c==='"'&&l[i+1]==='"'){cur+='"';i++;continue}if(c==='"'){q=!q;continue}if(c===','&&!q){out.push(cur);cur='';continue}cur+=c}out.push(cur);return out};const head=parseLine(lines[0]).map(x=>x.trim());return lines.slice(1).map(l=>{let a=parseLine(l),o={};head.forEach((h,i)=>o[h]=a[i]??'');return o});}
async function loadFile(file,type){
 if(!file)return;
 const status=document.getElementById('uploadStatus');
 if(status)status.textContent='Reading '+file.name+'…';
 try{
  let rows;
  if(file.name.toLowerCase().endsWith('.csv'))rows=parseCSV(await file.text());
  else rows=await parseXLSX(await file.arrayBuffer());
  rows=normalizeRows(rows,type);
  if(!rows.length)throw Error('The uploaded file contains no usable data rows.');
  if(type==='sales'){state.sales=rows;state.salesLoaded=true;}
  else{state.targets=rows;state.targetsLoaded=true;}
  state.loaded=state.salesLoaded&&state.targetsLoaded;
  state.history.push({name:file.name,type,rows:rows.length,when:new Date().toLocaleString()});
  toast(type==='sales'?'Sales data uploaded':'ASO targets uploaded');
  if(state.loaded){
   state.page='command';
   document.getElementById('fyBadge').textContent='FY '+currentFY();
   render();
  }else{
   renderUpload();
  }
 }catch(e){
  console.error(e);
  const msg='Could not parse file: '+e.message;
  if(document.getElementById('uploadStatus'))document.getElementById('uploadStatus').textContent=msg;
  toast('File parsing failed');
 }
}
function normalizeRows(rows,type){return rows.map(r=>{
 let o={};
 for(const [k,v] of Object.entries(r)){const kk=String(k).trim();o[kk]=typeof v==='string'?v.trim():v}
 if(type==='sales'){
  const map={state:'STATE','customer name':'Customer Name','customer':'Customer Name','channel partner name':'Customer Name','channel partner':'Customer Name','item':'Item','category':'CATEGORY','shipped qty':'Shipped Qty','quantity':'Shipped Qty','value':'Value','month':'Month','fy':'FY','executive':'Executive','executive name':'Executive','aso':'Executive'};
  let n={};
  for(const [k,v] of Object.entries(o))n[map[norm(k)]||k]=v;
  n.FY=normFY(n.FY);n.Month=normMonth(n.Month);
  ['STATE','Customer Name','Item','CATEGORY','Executive'].forEach(k=>{if(n[k]!==undefined)n[k]=String(n[k]).trim().replace(/\s+/g,' ')});
  return n;
 }
 // ASO target template: Channel Partner Name | ASO | Apr-26 ... Mar-27.
 // Channel Partner Name is retained as the target dealer dimension; ASO maps to Executive.
 // The month headers define FY 26-27, so a separate FY column is not required.
 let n={FY:'26-27'};
 for(const [k,v] of Object.entries(o)){
  const kk=norm(k);
  if(kk==='executive name'||kk==='executive'||kk==='aso'||kk==='aso name'||kk==='sales officer'){
    n.Executive=String(v??'').trim().replace(/\s+/g,' ');continue;
  }
  if(kk==='channel partner name'||kk==='channel partner'||kk==='dealer'||kk==='customer name'){
    n['Customer Name']=String(v??'').trim().replace(/\s+/g,' ');continue;
  }
  if(kk==='financial year'||kk==='fy'||kk==='financialyear'){n.FY=normFY(v)||'26-27';continue;}
  const mm=normMonth(k);
  if(months.includes(mm))n[mm]=v;
 }
 n.FY=normFY(n.FY)||'26-27';
 return n;
});}
