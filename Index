async function parseXLSX(buf){const u=new Uint8Array(buf),dv=new DataView(buf);let p=0,files={};while(p+30<u.length){if(dv.getUint32(p,true)!==0x04034b50)break;let method=dv.getUint16(p+8,true),csize=dv.getUint32(p+18,true),nlen=dv.getUint16(p+26,true),elen=dv.getUint16(p+28,true),name=new TextDecoder().decode(u.slice(p+30,p+30+nlen));let start=p+30+nlen+elen;let data=u.slice(start,start+csize);files[name]={method,data};p=start+csize}async function unzip(f){if(!f)throw Error('Missing XLSX component');if(f.method===0)return f.data;if(f.method===8){let ds=new DecompressionStream('deflate-raw'),ab=await new Response(new Blob([f.data]).stream().pipeThrough(ds)).arrayBuffer();return new Uint8Array(ab)}throw Error('Unsupported XLSX compression')};const xml=async n=>new TextDecoder().decode(await unzip(files[n]));let shared=[];if(files['xl/sharedStrings.xml']){let s=await xml('xl/sharedStrings.xml'),d=new DOMParser().parseFromString(s,'application/xml');shared=[...d.getElementsByTagName('si')].map(si=>[...si.getElementsByTagName('t')].map(t=>t.textContent).join(''))}let wb=await xml('xl/workbook.xml'),wd=new DOMParser().parseFromString(wb,'application/xml'),rels=await xml('xl/_rels/workbook.xml.rels'),rd=new DOMParser().parseFromString(rels,'application/xml');let sheets=[...wd.getElementsByTagName('sheet')],rid=sheets[0]?.getAttribute('r:id'),rel=[...rd.getElementsByTagName('Relationship')].find(x=>x.getAttribute('Id')===rid),path=rel?.getAttribute('Target')||'worksheets/sheet1.xml';path=path.replace(/^\//,'');if(!path.startsWith('xl/'))path='xl/'+path;let sx=await xml(path),sd=new DOMParser().parseFromString(sx,'application/xml');let rows=[...sd.getElementsByTagName('row')].map(row=>{let vals=[];[...row.getElementsByTagName('c')].forEach(c=>{let ref=c.getAttribute('r')||'',m=ref.match(/[A-Z]+/),letters=m?m[0]:'';let col=0;for(let ch of letters)col=col*26+ch.charCodeAt(0)-64;col--;let t=c.getAttribute('t'),v=c.getElementsByTagName('v')[0]?.textContent||'';if(t==='s')v=shared[+v]||'';vals[col]=v});return vals});let head=rows.shift()||[];return rows.map(a=>Object.fromEntries(head.map((h,i)=>[h||'Column '+(i+1),a[i]??''])))}
