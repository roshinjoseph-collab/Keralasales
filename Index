<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>KOEL Sales Intelligence</title>
<style>
:root{--bg:#07111f;--panel:#0d1a2b;--panel2:#101f33;--text:#edf4ff;--muted:#8fa5bd;--line:#1d3047;--accent:#48b6ff;--accent2:#65d6b2;--warn:#f6bd60;--danger:#ff7180;--good:#67d7a2;--shadow:0 18px 55px rgba(0,0,0,.25)}
:root.light{--bg:#f3f6fa;--panel:#fff;--panel2:#f8fafc;--text:#132238;--muted:#66788f;--line:#dce4ee;--accent:#1677b8;--accent2:#138a68;--warn:#b77908;--danger:#c53b4b;--good:#198754;--shadow:0 12px 35px rgba(23,48,76,.10)}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 20% 0%,rgba(72,182,255,.09),transparent 28%),var(--bg);color:var(--text);font:13px/1.45 Inter,Segoe UI,Arial,sans-serif}.app{display:grid;grid-template-columns:245px 1fr;min-height:100vh}.sidebar{position:sticky;top:0;height:100vh;border-right:1px solid var(--line);background:rgba(7,17,31,.92);padding:18px 13px;overflow:auto}.light .sidebar{background:#fff}.brand{padding:8px 10px 20px}.brand b{font-size:17px;letter-spacing:.8px}.brand small{display:block;color:var(--muted);margin-top:4px}.navgroup{margin:18px 0 8px;padding:0 10px;color:#6f879f;text-transform:uppercase;font-size:10px;letter-spacing:1.4px}.nav{display:block;width:100%;border:0;background:transparent;color:var(--muted);padding:9px 11px;text-align:left;border-radius:9px;cursor:pointer}.nav:hover,.nav.active{background:rgba(72,182,255,.10);color:var(--text)}.main{min-width:0}.topbar{height:72px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 24px;position:sticky;top:0;background:color-mix(in srgb,var(--bg) 91%,transparent);backdrop-filter:blur(14px);z-index:5}.topbar h1{font-size:17px;margin:0}.topbar p{margin:3px 0 0;color:var(--muted);font-size:11px}.actions{display:flex;gap:8px;align-items:center}.btn,.select,.input{border:1px solid var(--line);background:var(--panel);color:var(--text);border-radius:8px;padding:8px 10px}.btn{cursor:pointer}.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}.btn:hover{filter:brightness(1.08)}.content{padding:22px;max-width:1800px;margin:auto}.upload{min-height:calc(100vh - 116px);display:grid;place-items:center}.uploadbox{max-width:900px;width:100%;background:linear-gradient(145deg,var(--panel),var(--panel2));border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow);padding:34px}.uploadbox h2{font-size:30px;margin:0 0 7px}.uploadbox>p{color:var(--muted);margin:0 0 24px}.dropgrid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.drop{border:1px dashed #42617e;background:rgba(255,255,255,.02);border-radius:15px;padding:22px}.drop h3{margin:0 0 4px}.drop p{color:var(--muted);min-height:38px}.drop input{width:100%}.privacy{margin-top:18px;padding:12px;border-radius:10px;background:rgba(101,214,178,.08);color:var(--good)}.status{margin-top:14px;color:var(--muted)}.hidden{display:none!important}.filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px;padding:12px;background:var(--panel);border:1px solid var(--line);border-radius:13px}.filters .group{display:flex;gap:6px;align-items:center}.filters label{font-size:10px;color:var(--muted);text-transform:uppercase}.cards{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}.card{background:linear-gradient(145deg,var(--panel),var(--panel2));border:1px solid var(--line);border-radius:13px;padding:15px;box-shadow:var(--shadow);min-width:0}.card .label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.8px}.value{font-size:23px;font-weight:700;margin-top:7px;white-space:nowrap}.sub{font-size:11px;color:var(--muted);margin-top:4px}.positive{color:var(--good)}.negative{color:var(--danger)}.warning{color:var(--warn)}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:12px;margin-top:12px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:13px;padding:14px;min-width:0}.span4{grid-column:span 4}.span6{grid-column:span 6}.span8{grid-column:span 8}.span12{grid-column:span 12}.panel h3{font-size:13px;margin:0}.panel .hint{font-size:10px;color:var(--muted)}.chart{height:300px;margin-top:8px}.tablewrap{overflow:auto;max-height:430px;margin-top:10px}.table{width:100%;border-collapse:collapse;font-size:11px}.table th,.table td{padding:8px;border-bottom:1px solid var(--line);white-space:nowrap}.table th{position:sticky;top:0;background:var(--panel2);text-align:left;color:var(--muted)}.clickrow{cursor:pointer}.clickrow:hover{background:rgba(72,182,255,.06)}.pill{display:inline-block;padding:3px 7px;border-radius:99px;background:rgba(72,182,255,.10);color:var(--accent);font-size:10px}.hero{padding:22px;border:1px solid var(--line);background:linear-gradient(135deg,rgba(72,182,255,.12),transparent 55%),var(--panel);border-radius:16px;margin-bottom:12px}.hero h2{margin:0 0 3px;font-size:22px}.hero p{margin:0;color:var(--muted)}.metricline{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding:9px 0}.metricline:last-child{border-bottom:0}.bar{height:9px;background:var(--line);border-radius:99px;overflow:hidden}.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:99px}.insight{padding:11px;border-left:3px solid var(--accent);background:var(--panel2);border-radius:7px;margin:7px 0}.toast{position:fixed;right:18px;bottom:18px;background:var(--panel);border:1px solid var(--line);padding:12px 15px;border-radius:9px;box-shadow:var(--shadow);z-index:50}.footer{color:var(--muted);font-size:10px;margin-top:18px}.modal{position:fixed;inset:0;background:rgba(0,0,0,.62);display:grid;place-items:center;z-index:40}.modalbox{width:min(1000px,92vw);max-height:86vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:20px}.modalhead{display:flex;justify-content:space-between;align-items:center}.cmd{font-family:ui-monospace,monospace;color:var(--accent)}@media(max-width:1100px){.cards{grid-template-columns:repeat(3,1fr)}.span4,.span6{grid-column:span 6}.app{grid-template-columns:205px 1fr}}@media(max-width:760px){.app{display:block}.sidebar{position:fixed;left:-245px;z-index:20;transition:.2s}.sidebar.open{left:0}.topbar{padding:0 12px}.content{padding:12px}.cards{grid-template-columns:repeat(2,1fr)}.dropgrid{grid-template-columns:1fr}.span4,.span6,.span8,.span12{grid-column:span 12}}
@media print{.sidebar,.topbar,.filters,.btn{display:none!important}.app{display:block}.content{padding:0}.panel,.card,.hero{box-shadow:none;break-inside:avoid}.chart{height:260px}}
</style>
</head>
<body>
<div id="app" class="app">
<aside class="sidebar" id="sidebar"><div class="brand"><b>KOEL SALES INTELLIGENCE</b><small>Management BI • Offline</small></div><div id="nav"></div></aside>
<main class="main"><header class="topbar"><div><h1>KOEL SALES INTELLIGENCE</h1><p>Sales Performance • Target Achievement • Growth • Forecast • H2 Intelligence</p></div><div class="actions"><span class="pill" id="fyBadge">No data</span><button class="btn" onclick="toggleTheme()">Theme</button><button class="btn" onclick="printReport()">Print</button><button class="btn primary" onclick="showPage('upload')">Upload</button></div></header>
<section class="content" id="content"></section></main></div>
<div id="modal" class="hidden"></div><div id="toast" class="hidden"></div>
<script>
/* Native offline implementation. The application deliberately avoids remote assets and requests. */
const state={sales:[],targets:[],page:'command',filters:{fy:'ALL',month:'ALL',state:'ALL',exec:'ALL',dealer:'ALL',cat:'ALL',product:'ALL'},theme:localStorage.getItem('koelTheme')||'dark',loaded:false,salesLoaded:false,targetsLoaded:false,history:[],actions:[]};
const months=['Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec','Jan','Feb','Mar'];
const navGroups={Executive:['command'],Performance:['sales','monthly','executive','state','dealer','category','product'],"Target & Gap":['target','h2','runrate','forecast','recovery','scenario'],Intelligence:['growth','risk','concentration','mix','realisation','opportunity'],Comparison:['comparison'],Reporting:['reports','board','export'],System:['quality','upload','saved','settings']};
const labels={command:'Command Center',summary:'Executive Summary',cockpit:'Management Cockpit',sales:'Sales Overview',monthly:'Monthly Trends',executive:'Executive Performance',state:'State Performance',dealer:'Dealer Performance',category:'Category Intelligence',product:'Product Intelligence',target:'Target vs Actual',h2:'H2 Gap Analysis',runrate:'Run Rate',forecast:'Forecast',recovery:'Recovery Planner',scenario:'Scenario Simulator',growth:'Growth Intelligence',risk:'Dealer Risk',concentration:'Concentration',mix:'Mix Analysis',realisation:'Price / Realisation',opportunity:'Opportunity Finder',comparison:'Comparison Studio',reports:'Reports',board:'Board Pack',export:'Export Center',quality:'Data Quality',upload:'Upload Center',saved:'Saved Views',settings:'Settings'};
function esc(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
function money(v){return '₹ '+(Number(v||0)/100000).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2})+' L';}
function pct(v){return (Number.isFinite(v)?v:0).toFixed(1)+'%';}
function yoy(curr,prev){if(prev===null||prev===undefined||!Number.isFinite(prev)||prev===0)return null;return (curr-prev)/prev*100;}
function yoyText(curr,prev){const g=yoy(curr,prev);return g===null?'N/A':pct(g);}
function yoyClass(curr,prev){const g=yoy(curr,prev);return g===null?'':g>=0?'positive':'negative';}
function execTarget(exec){return targetFor(exec);}
function executiveRows(fy){return aggregate(state.sales.filter(r=>r.FY===fy),'Executive');}
function dealerRowsForExecutive(exec,fy){return aggregate(state.sales.filter(r=>r.FY===fy&&r.Executive===exec),'Customer Name');}
function categoryRowsForExecutive(exec,fy){return aggregate(state.sales.filter(r=>r.FY===fy&&r.Executive===exec),'CATEGORY');}
function productRowsForExecutive(exec,fy){return aggregate(state.sales.filter(r=>r.FY===fy&&r.Executive===exec),'Item');}
function redFlagHtml(items,empty='No material red flags identified from the available comparison data.'){return items.length?items.slice(0,12).map(x=>`<div class="insight" style="border-left-color:var(--danger)"><b>${esc(x.title)}</b><br><span class="sub">${esc(x.detail)}</span></div>`).join(''):`<div class="sub">${empty}</div>`;}

function num(v){return Number(v||0).toLocaleString('en-IN',{maximumFractionDigits:2});}
function norm(s){return String(s??'').trim().replace(/\s+/g,' ').toLowerCase();}
function title(s){return String(s??'').replace(/\b\w/g,c=>c.toUpperCase());}
function toast(t){const e=document.getElementById('toast');e.textContent=t;e.className='toast';clearTimeout(window.__toast);window.__toast=setTimeout(()=>e.className='hidden',2800)}
function toggleTheme(){state.theme=state.theme==='dark'?'light':'dark';document.documentElement.classList.toggle('light',state.theme==='light');localStorage.setItem('koelTheme',state.theme);}
function initNav(){
  let h='';
  for(const [g,items] of Object.entries(navGroups)){
    h+=`<div class="navgroup">${g}</div>`;
    h+=items.map(x=>`<button type="button" class="nav" data-page="${esc(x)}">${esc(labels[x])}</button>`).join('');
  }
  const nav=document.getElementById('nav');
  nav.innerHTML=h;
  nav.addEventListener('click',e=>{
    const btn=e.target.closest('.nav');
    if(btn) showPage(btn.dataset.page);
  });
}
function showPage(p){
  if(!labels[p]) return;
  state.page=p;
  document.querySelectorAll('.nav').forEach(x=>x.classList.toggle('active',x.dataset.page===p));
  render();
  window.scrollTo({top:0,behavior:'smooth'});
}
function render(){
  if(!state.loaded || state.page==='upload') return renderUpload();
  document.getElementById('content').innerHTML=pageTemplate(state.page);
  syncFilterControls();
  bindFilterEvents();
  attachFilters();
  drawPage(state.page);
}
function syncFilterControls(){
  document.querySelectorAll('.filters select[data-filter]').forEach(el=>{
    const k=el.dataset.filter;
    const v=state.filters[k] ?? 'ALL';
    const has=[...el.options].some(o=>o.value===v);
    el.value=has?v:'ALL';
  });
}

function renderUpload(){
 const salesState=state.salesLoaded?`<span class="positive">✓ Sales data loaded (${state.sales.length.toLocaleString()} rows)</span>`:'<span>○ Sales data pending</span>';
 const targetFys=[...new Set(state.targets.map(x=>normFY(x.FY)).filter(Boolean))];
 const targetExecs=[...new Set(state.targets.map(x=>String(x.Executive||'').trim()).filter(Boolean))];
 const targetTotalL=state.targets.reduce((a,x)=>a+months.reduce((s,m)=>s+targetNumber(x[m]),0),0);
 const targetState=state.targetsLoaded?`<span class="positive">✓ ASO targets loaded (${targetExecs.length} executives • ${targetFys.join(', ')||'FY not detected'} • ₹ ${targetTotalL.toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2})} L total)</span>`:'<span>○ ASO targets pending</span>';
 const ready=state.salesLoaded&&state.targetsLoaded;
 document.getElementById('content').innerHTML=`<div class="upload"><div class="uploadbox"><h2>Premium Sales Intelligence</h2><p>Load both Sales Data and ASO Targets before entering the dashboard. Either file can be uploaded first.</p><div class="dropgrid"><div class="drop"><h3>01 • SALES DATA</h3><p>Expected: STATE, Customer Name, Item, CATEGORY, Shipped Qty, Value, Month, FY, Executive</p><input type="file" id="salesFile" accept=".xlsx,.xls,.csv" onchange="loadFile(this.files[0],'sales')"><div class="status">${salesState}</div></div><div class="drop"><h3>02 • ASO TARGETS</h3><p>Channel Partner Name, ASO, Apr-26 … Mar-27. Excel date-formatted month headers are supported. Values must be actual ₹ amounts; FY 26-27 is inferred from the month headers.</p><input type="file" id="targetFile" accept=".xlsx,.xls,.csv" onchange="loadFile(this.files[0],'targets')"><div class="status">${targetState}</div></div></div><div style="margin-top:15px"><button class="btn" onclick="sampleData()">Load Sample Data</button> <button class="btn" onclick="downloadTemplate()">Download Blank Template</button></div><div class="privacy">100% Local • Your data never leaves this computer</div><div class="status" id="uploadStatus">${ready?'Both files are ready. Opening the dashboard…':state.salesLoaded?'Sales data is ready. Please upload ASO targets to continue.':state.targetsLoaded?'ASO targets are ready. Please upload Sales Data to continue.':'No data loaded. Offline native parser supports CSV and modern XLSX files.'}</div><div class="status">ASO target upload supports the exact format: Channel Partner Name + ASO + Apr-26 to Mar-27. Excel-formatted month headers are supported. Values are actual ₹ and are displayed as ₹ Lakhs. FY 26-27 is assigned automatically.</div></div></div>`;
}
function pageTemplate(p){const f=filterBar();const hero=`<div class="hero"><h2>${labels[p]}</h2><p>FY ${currentFY()} • Financial Values: ₹ Lakhs • Click charts/tables to drill down.</p></div>`;let body='';if(p==='command')body=overviewBody(p);else if(['sales','monthly'].includes(p))body=overviewBody(p);else if(p==='executive')body=executivePerformanceBody();else if(p==='dealer')body=dealerPerformanceBody();else if(['state','category','product'].includes(p))body=dimensionBody(p);else if(['target','h2','runrate','forecast','recovery','scenario'].includes(p))body=targetBody(p);else if(['growth','risk','concentration','mix','realisation','opportunity'].includes(p))body=intelligenceBody(p);else if(p==='comparison')body=comparisonBody();else if(['reports','board','export'].includes(p))body=reportBody(p);else if(p==='quality')body=qualityBody();else if(['saved','settings'].includes(p))body=settingsBody(p);return hero+f+body+`<div class="footer">Offline local analytics • No server • No telemetry • ₹ Lakhs only</div>`;}
function currentFY(){const a=[...new Set([...state.sales,...state.targets].map(x=>normFY(x.FY)).filter(Boolean))];return a.sort((x,y)=>fyStartYear(y)-fyStartYear(x))[0]||'26-27';}
function filterBar(){
  const opts=(field)=>{
    const values=[]; const seen=new Set();
    for(const row of state.sales){
      const raw=row[field]; if(raw===undefined||raw===null||String(raw).trim()==='') continue;
      const value=String(raw).trim(), key=norm(value);
      if(!seen.has(key)){seen.add(key);values.push(value);}
    }
    values.sort((a,b)=>a.localeCompare(b,undefined,{numeric:true,sensitivity:'base'}));
    return ['ALL',...values].map(v=>`<option value="${esc(v)}">${esc(v==='ALL'?'All':v)}</option>`).join('');
  };
  const fyValues=[...new Set([...state.sales,...state.targets].map(r=>normFY(r.FY)).filter(Boolean))].sort((a,b)=>fyStartYear(a)-fyStartYear(b));
  const fyOpts=['ALL',...fyValues].map(v=>`<option value="${esc(v)}">${esc(v==='ALL'?'All FY':v)}</option>`).join('');
  return `<div class="filters" id="globalFilters">
    <div class="group"><label>FY</label><select data-filter="fy" class="select">${fyOpts}</select></div>
    <div class="group"><label>Month / Period</label><select data-filter="month" class="select"><option value="ALL">All</option><option value="H1">H1 (Apr-Sep)</option><option value="H2">H2 (Oct-Mar)</option><option value="Q1">Q1 (Apr-Jun)</option><option value="Q2">Q2 (Jul-Sep)</option><option value="Q3">Q3 (Oct-Dec)</option><option value="Q4">Q4 (Jan-Mar)</option>${months.map(v=>`<option value="${v}">${v}</option>`).join('')}</select></div>
    <div class="group"><label>State</label><select data-filter="state" class="select">${opts('STATE')}</select></div>
    <div class="group"><label>Executive</label><select data-filter="exec" class="select">${opts('Executive')}</select></div>
    <div class="group"><label>Dealer</label><select data-filter="dealer" class="select">${opts('Customer Name')}</select></div>
    <div class="group"><label>Category</label><select data-filter="cat" class="select">${opts('CATEGORY')}</select></div>
    <div class="group"><label>Product</label><select data-filter="product" class="select">${opts('Item')}</select></div>
    <button type="button" class="btn" id="clearFiltersBtn">Clear</button>
  </div>`;
}
function setFilter(k,v){ if(k in state.filters){ state.filters[k]=v||'ALL'; render(); } }
function clearFilters(){ state.filters={fy:'ALL',month:'ALL',state:'ALL',exec:'ALL',dealer:'ALL',cat:'ALL',product:'ALL'}; render(); }
function bindFilterEvents(){
  const box=document.getElementById('globalFilters'); if(!box) return;
  box.addEventListener('change',e=>{const el=e.target.closest('select[data-filter]'); if(el) setFilter(el.dataset.filter,el.value);});
  const clear=document.getElementById('clearFiltersBtn'); if(clear) clear.addEventListener('click',clearFilters);
}
function normMonth(v){
 if(v===null||v===undefined||v==='')return '';
 if(v instanceof Date && !Number.isNaN(v.getTime()))return ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][v.getMonth()];
 const raw=String(v).trim();
 if(!raw)return '';
 const num=Number(raw);
 // Excel date serials used by formatted XLSX month headers (e.g. 46113 = 1-Apr-2026).
 if(Number.isFinite(num) && num>20000 && num<80000){
   const d=new Date(Date.UTC(1899,11,30)+num*86400000);
   if(!Number.isNaN(d.getTime()))return ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][d.getUTCMonth()];
 }
 let x=raw.toLowerCase().replace(/[._]/g,'-').replace(/\s+/g,'');
 const map={jan:'Jan',january:'Jan',feb:'Feb',february:'Feb',mar:'Mar',march:'Mar',apr:'Apr',april:'Apr',may:'May',jun:'Jun',june:'Jun',jul:'Jul',july:'Jul',aug:'Aug',august:'Aug',sep:'Sep',sept:'Sep',september:'Sep',oct:'Oct',october:'Oct',nov:'Nov',november:'Nov',dec:'Dec',december:'Dec'};
 const m=x.match(/^(jan|january|feb|february|mar|march|apr|april|may|jun|june|jul|july|aug|august|sep|sept|september|oct|october|nov|november|dec|december)(?:[-\/ ]?(?:20)?\d{2})?$/);
 if(m)return map[m[1]];
 const dt=new Date(raw);
 if(!Number.isNaN(dt.getTime()) && /(?:^|[-\/\s])(?:20)?\d{2}(?:$|[-\/\s])/.test(raw))return ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][dt.getMonth()];
 return raw;
}
function targetNumber(v){
 if(v===null||v===undefined||v==='')return 0;
 const raw=String(v).trim();
 const s=raw.replace(/,/g,'');
 const n=parseFloat(s.replace(/[^0-9.\-]/g,''));
 if(!Number.isFinite(n))return 0;
 // ASO upload values are ACTUAL ₹ amounts. Dashboard calculations use ₹ Lakhs.
 // Example: 4500000 in Excel becomes ₹ 45.00 L in the dashboard.
 return n/100000;
}
function fyStartYear(v){const x=String(v??'').trim();const m=x.match(/(?:FY\s*)?(20\d{2})\s*[-\/]\s*(20\d{2}|\d{2})/i);if(m)return Number(m[1]);const y=x.match(/\b(\d{2})\s*[-\/]\s*(\d{2})\b/);return y?2000+Number(y[1]):0;}
function normFY(v){let x=String(v??'').trim().replace(/\s+/g,' ');if(!x)return '';let m=x.match(/(?:FY\s*)?(20\d{2})\s*[-\/]\s*(20\d{2}|\d{2})/i);if(m){const a=String(m[1]).slice(-2),b=String(m[2]).length===4?String(m[2]).slice(-2):String(m[2]).padStart(2,'0');return a+'-'+b;}m=x.match(/\b(\d{2})\s*[-\/]\s*(\d{2})\b/);return m?m[1]+'-'+m[2]:x;}
function sameDim(a,b){return norm(a)===norm(b);}
function periodMonths(period){const p=String(period||'ALL');if(p==='H1')return months.slice(0,6);if(p==='H2')return months.slice(6);if(p==='Q1')return months.slice(0,3);if(p==='Q2')return months.slice(3,6);if(p==='Q3')return months.slice(6,9);if(p==='Q4')return months.slice(9,12);if(p==='ALL')return months;return [normMonth(p)];}
function availableFYMonths(fy){const seen=new Set();state.sales.forEach(r=>{if(normFY(r.FY)===normFY(fy)){const m=normMonth(r.Month);if(months.includes(m))seen.add(m);}});return months.filter(m=>seen.has(m));}
function activePeriodMonths(fy){return state.filters.month==='ALL'?availableFYMonths(fy):periodMonths(state.filters.month);}
function periodFilter(rows,fy){const wanted=activePeriodMonths(fy);return rows.filter(r=>normFY(r.FY)===normFY(fy)&&wanted.includes(normMonth(r.Month)));}
function monthMatches(rowMonth,period){return periodMonths(period).includes(normMonth(rowMonth));}
function filtered(){const fy=state.filters.fy==='ALL'?currentFY():state.filters.fy;const wanted=activePeriodMonths(fy);return state.sales.filter(r=>(normFY(r.FY)===normFY(fy))&&wanted.includes(normMonth(r.Month))&&(state.filters.state==='ALL'||sameDim(r.STATE,state.filters.state))&&(state.filters.exec==='ALL'||sameDim(r.Executive,state.filters.exec))&&(state.filters.dealer==='ALL'||sameDim(r['Customer Name'],state.filters.dealer))&&(state.filters.cat==='ALL'||sameDim(r.CATEGORY,state.filters.cat))&&(state.filters.product==='ALL'||sameDim(r.Item,state.filters.product)));}
